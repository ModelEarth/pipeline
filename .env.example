# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── App database (Azure SQL Server, "DBMonitor") ─────────────────────────────
# Either set the full connection string directly:
# ConnectionStrings__DefaultConnection=Server=tcp:<server>.database.windows.net,1433;Database=DBMonitor;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
# ...or just these, and the app builds the connection string itself:
DBMONITOR_HOST=<server>.database.windows.net
DBMONITOR_PORT=1433
DBMONITOR_NAME=DBMonitor
DBMONITOR_USER=<user>
DBMONITOR_PASSWORD=<password>

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<client-id>
GOOGLE_CLIENT_SECRET=<client-secret>

# ── EXIOBASE industry database (Azure PostgreSQL) ─────────────────────────────
# Seeds the shared "IndustryDB (Azure PostgreSQL)" connection profile.
EXIOBASE_HOST=<host>.postgres.database.azure.com
EXIOBASE_PORT=5432
EXIOBASE_NAME=<database>
EXIOBASE_USER=<username>
EXIOBASE_PASSWORD=<password>
EXIOBASE_SSL_MODE=require
